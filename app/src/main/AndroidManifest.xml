<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network: Haier (UDP 7083 discovery, TCP 56800 control), Gree (UDP 7000). Internet: only the
         one-time Haier account sign-in and key fetch (HTTPS + MQTT over TLS to Haier's service). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the phone is on Wi-Fi, and its own address/subnet to search. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Whether Wi-Fi is switched on, to tell "Wi-Fi off" from "not joined". -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Multicast lock during AC discovery and sessions: Haier modules answer the search with a broadcast,
         which Wi-Fi power saving drops unless the lock is held. Also used by the network devices scanner. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Held only during AC discovery and control sessions: a Wi-Fi lock so the radio does not doze mid-session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- "Nearby devices" before every AC search: lets the app read the joined Wi-Fi network and, on some
         phones, receive broadcast replies. Android 13+: NEARBY_WIFI_DEVICES, never used for location.
         Android 12 and lower: the same access is gated behind location (the app never reads a location). -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />

    <!-- Bluetooth is optional: only setting up a brand-new AC uses it. An AC already on Wi-Fi is found over the LAN.
         BLUETOOTH_CONNECT lets the app ask the user to switch Bluetooth on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.wifi" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Only to open the HaiSmart app when an AC still has to be added to a Haier account there. -->
    <queries>
        <package android:name="com.haier.uhome.uplus.seasia" />
    </queries>

    <application
        android:name=".RoomAcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoomAc">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
